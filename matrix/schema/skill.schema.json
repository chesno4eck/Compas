{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://competency-matrix.local/schema/skill.schema.json",
  "title": "Skill",
  "description": "Frontmatter + логическая модель навыка матрицы компетенций",
  "type": "object",
  "required": ["id", "name", "summary", "category", "levels", "status"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]{1,7}$",
      "description": "Стабильный код навыка, например IOSD, TEST"
    },
    "name": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "category": {
      "type": "string",
      "enum": ["development", "quality", "platform", "security", "leadership", "other"]
    },
    "sfia_base": {
      "type": ["string", "null"],
      "description": "Код базового навыка SFIA, если есть"
    },
    "sfia_version": { "type": ["string", "null"] },
    "levels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1, "maximum": 7 }
    },
    "status": {
      "type": "string",
      "enum": ["draft", "review", "active", "deprecated"]
    }
  }
}
