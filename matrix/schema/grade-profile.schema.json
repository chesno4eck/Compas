{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://competency-matrix.local/schema/grade-profile.schema.json",
  "title": "GradeProfile",
  "description": "Требования грейда роли к навыкам",
  "type": "object",
  "required": ["role_id", "grade", "label", "status", "requirements"],
  "additionalProperties": false,
  "properties": {
    "role_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "grade": {
      "type": "string",
      "enum": ["intern", "junior", "middle", "senior", "lead", "principal"]
    },
    "label": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["draft", "review", "active", "deprecated"]
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["skill_id", "min_level", "priority"],
        "additionalProperties": false,
        "properties": {
          "skill_id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]{1,7}$"
          },
          "min_level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          },
          "priority": {
            "type": "string",
            "enum": ["required", "optional"]
          },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
